{
  "code-formatter": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "dart format lib/ -l 100",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "dart format lib/ -l 100",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
